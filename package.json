{
  "scripts": {
    "dev": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --watch",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --minify",
    "build:js": "esbuild resources/js/session-qrcode.js resources/js/public-leaderboard.js resources/js/participant-quiz.js --bundle --minify --platform=browser --outdir=public/assets/js"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
